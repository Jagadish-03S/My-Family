rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/familySpaces/$(familyId)/memberships/$(request.auth.uid));
    }

    function getMemberRole(familyId) {
      return get(/databases/$(database)/documents/familySpaces/$(familyId)/memberships/$(request.auth.uid)).data.role;
    }

    function isOwnerOrAdmin(familyId) {
      return isFamilyMember(familyId) && getMemberRole(familyId) in ['Owner', 'Admin'];
    }

    function isEditorOrHigher(familyId) {
      return isFamilyMember(familyId) && getMemberRole(familyId) in ['Owner', 'Admin', 'Editor'];
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Family Spaces collection
    match /familySpaces/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isAuthenticated();
      allow update: if isOwnerOrAdmin(familyId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Subcollections under Family Space
      match /memberships/{membershipUserId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isOwnerOrAdmin(familyId);
      }

      match /people/{personId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isEditorOrHigher(familyId);
        allow delete: if isOwnerOrAdmin(familyId);
      }

      match /relationships/{relId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isEditorOrHigher(familyId);
      }

      match /memories/{memoryId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isEditorOrHigher(familyId);
        allow delete: if isOwnerOrAdmin(familyId);
      }

      match /activities/{activityId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isEditorOrHigher(familyId);
      }

      match /albums/{albumId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isEditorOrHigher(familyId);
      }

      match /invitations/{inviteId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isOwnerOrAdmin(familyId);
      }

      match /auditLogs/{logId} {
        allow read: if isOwnerOrAdmin(familyId);
        allow create: if isFamilyMember(familyId);
      }
    }
  }
}
