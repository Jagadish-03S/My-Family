rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isApprovedFormat() {
      return request.resource.contentType.matches('image/jpeg') ||
             request.resource.contentType.matches('image/png') ||
             request.resource.contentType.matches('image/webp');
    }

    function isMaxSizeBytes(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    match /familySpaces/{familyId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isApprovedFormat() && isMaxSizeBytes(10);
    }
  }
}
